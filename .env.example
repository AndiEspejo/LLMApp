# Copy to .env (`make setup` does this for you). Never commit .env.

# --- Postgres (docker-compose) ------------------------------------------------
POSTGRES_USER=clinicflow
POSTGRES_PASSWORD=clinicflow
POSTGRES_DB=clinicflow
POSTGRES_PORT=5432

# --- API (apps/api) -----------------------------------------------------------
ENVIRONMENT=local
# Driver is psycopg 3 ("postgresql+psycopg"). Keep in sync with the values above.
DATABASE_URL=postgresql+psycopg://clinicflow:clinicflow@localhost:5432/clinicflow
# Comma-separated origins allowed to call the API from a browser.
API_CORS_ORIGINS=http://localhost:3000

# --- Web (apps/web) -----------------------------------------------------------
# Used server-side by Next.js to reach the API.
API_URL=http://localhost:8000

# --- n8n (docker-compose) -----------------------------------------------------
N8N_PORT=5678
N8N_DB_NAME=n8n
# Pin a version (e.g. 1.123.0) once you rely on specific nodes.
N8N_VERSION=latest
# Encrypts credentials stored in n8n. Generate one with: openssl rand -hex 32
# Changing it later makes existing saved credentials unreadable.
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
TZ=America/New_York

# --- AI / voice providers (not used yet; later phases) ------------------------
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPGRAM_API_KEY=
# ELEVENLABS_API_KEY=
